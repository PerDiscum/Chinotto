{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chinotto",
  "mainBinaryName": "chinotto",
  "version": "0.1.0",
  "identifier": "app.chinotto.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chinotto",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 460
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: art: http://art.localhost libart: http://libart.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage",
      "rpm"
    ],
    "category": "Music",
    "shortDescription": "Music library manager and iPod sync",
    "longDescription": "Chinotto manages a music library and keeps classic iPods and other players in sync.",
    "copyright": "© 2026 Chinotto contributors",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": [
          "udisks2"
        ]
      }
    }
  }
}
